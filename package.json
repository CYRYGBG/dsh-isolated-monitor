{
  "name": "dsh-isolated-monitor",
  "version": "0.1.0",
  "description": "DeepSeek Harness 独立会话定时监控插件：每次运行创建全新 Root Session，正常自动归档，仅异常回传原始主对话。",
  "type": "module",
  "main": "src/index.js",
  "icon": "assets/icon.svg",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1 <0.3.0",
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-isolated-monitor",
    "summary": "独立会话定时监控：每次巡检新建会话，正常自动归档，异常才回传原始主对话；支持去重、重试与重启恢复。",
    "categories": [
      "自动化",
      "监控"
    ],
    "surfaces": [
      "host"
    ],
    "capabilities": {
      "provides": [
        "tools:monitor_create",
        "tools:monitor_list",
        "tools:monitor_view",
        "tools:monitor_manage",
        "command:/monitor"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1 <0.3.0",
      "node": ">=22.18"
    },
    "permissions": {}
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-scope": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-user-approval": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-util-time": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:verbose": "node --test --test-reporter=spec test/*.test.mjs",
    "market:build": "node scripts/make-market-index.mjs",
    "market:check": "node scripts/make-market-index.mjs --check",
    "prepublishOnly": "node scripts/check-publish-ready.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "author": "dsh-isolated-monitor contributors",
  "homepage": "https://github.com/CYRYGBG/dsh-isolated-monitor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CYRYGBG/dsh-isolated-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/CYRYGBG/dsh-isolated-monitor/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "monitor",
    "cron",
    "schedule",
    "isolated-session",
    "alert",
    "automation",
    "监控",
    "定时任务",
    "独立会话"
  ]
}
